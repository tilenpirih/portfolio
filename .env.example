EMAILJS_PUBLIC_KEY=PUBLIC_KEY
EMAILJS_PRIVATE_KEY=PRIVATE_KEY
EMAILJS_SERVICE_ID=SECRET_KEY
EMAILJS_TEMPLATE_ID=TEMPLATE_ID

# The NUXT_PUBLIC_ prefix is load-bearing: it is the only name Nuxt reads at
# runtime to override runtimeConfig.public.BASE_URL. A bare BASE_URL is ignored,
# the value ends up empty, and canonical/og:image quietly render as relative URLs.
NUXT_PUBLIC_BASE_URL=https://tilenpirih.com
